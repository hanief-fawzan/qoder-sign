# Qoder Sign Configuration
# Copy this file to .env and configure as needed

# Browser Settings
HEADLESS=false
SLOW_MO=50

# Chrome Path (optional, auto-detect if empty)
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Mac: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/google-chrome
CHROME_PATH=

# Concurrency
CONCURRENT=1
DELAY_BETWEEN=8000

# Timeouts (milliseconds)
GOOGLE_TIMEOUT=120000
HP_PROMPT_WAIT=120000
NAV_TIMEOUT=30000
QODERCLI_TIMEOUT=180000

# Anti-banned: Randomization
RANDOM_DELAY_MIN=1000
RANDOM_DELAY_MAX=3000
TYPING_DELAY_MIN=30
TYPING_DELAY_MAX=80

# Retry Settings
MAX_RETRIES=3
RETRY_DELAY=15000
