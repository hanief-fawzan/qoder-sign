# ============================================================
#  Qoder Sign Configuration
#  Copy this file to .env and configure as needed
# ============================================================

# ─── Browser Mode ──────────────────────────────────────────
# local    = Local Puppeteer (requires Chrome installed)
# camofox  = CamoFox REST API (Docker container)
BROWSER_MODE=local

# ─── CamoFox Settings (only used when BROWSER_MODE=camofox) ─
CAMOFOX_HOST=127.0.0.1
CAMOFOX_PORT=9377
CAMOFOX_API_KEY=your_camofox_api_key_here
CAMOFOX_USER_ID=qoder-agent
CAMOFOX_HEADLESS=true

# ─── Local Browser Settings ────────────────────────────────
HEADLESS=false
SLOW_MO=50

# Chrome Path (optional, auto-detect if empty)
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Mac: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/google-chrome
CHROME_PATH=

# ─── Concurrency ───────────────────────────────────────────
CONCURRENT=1
DELAY_BETWEEN=8000

# ─── Timeouts (milliseconds) ───────────────────────────────
GOOGLE_TIMEOUT=120000
NAV_TIMEOUT=30000
QODERCLI_TIMEOUT=180000
QODERCLI_CALLBACK_TIMEOUT=120000

# ─── 2FA Settings ──────────────────────────────────────────
# 0         = auto-skip / auto-handle consent pages (no 2FA)
# >0        = seconds to wait for MANUAL 2FA in visible browser
#             e.g. 120 = wait up to 2 minutes for user action
TWO_FA_WAIT=0

# Optional: auto-fill TOTP code from env (skip manual 2FA)
# If set, script will auto-enter the code on the TOTP page.
# Leave empty to rely on TWO_FA_WAIT manual mode.
TOTP_CODE=

# ─── Typing Speed Preset ───────────────────────────────────
# Options: fast, normal, slow
# Each preset sets TYPING_DELAY, RANDOM_DELAY, and PAUSE ranges
# Override individual values below if needed
TYPING_SPEED=normal

# Anti-banned: Randomization (override preset values if needed)
# Leave commented to use preset defaults
# RANDOM_DELAY_MIN=1000
# RANDOM_DELAY_MAX=3000
# TYPING_DELAY_MIN=30
# TYPING_DELAY_MAX=80
# PAUSE_MIN=1500
# PAUSE_MAX=3000

# ─── First Interaction After Login ─────────────────────────
# Message sent after successful login to trigger Pro trial activation.
# Set empty to skip sending first message.
FIRST_MESSAGE=hi

# How long to wait for the first response (milliseconds)
FIRST_MESSAGE_TIMEOUT=60000

# ─── Retry Settings ────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY=15000
