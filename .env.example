# Browser Settings
# HEADLESS: true = no browser window, false = visible browser
# NOTE: Leave commented out — controlled by login.bat / login-headless.bat
# HEADLESS=false

# CHROME_PATH: path to Chrome executable (optional, auto-detect if not set)
# Examples:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Mac: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux: /usr/bin/google-chrome
# CHROME_PATH=

# SLOW_MO: delay between actions in milliseconds (default: 50)
SLOW_MO=50

# DELAY_BETWEEN: delay between accounts in milliseconds (default: 8000)
DELAY_BETWEEN=8000

# Timeouts (in milliseconds)
# GOOGLE_TIMEOUT: max time for Google login flow (default: 120000 = 2 minutes)
GOOGLE_TIMEOUT=120000

# HP_PROMPT_WAIT: max time to wait for HP verification (default: 120000 = 2 minutes)
HP_PROMPT_WAIT=120000

# NAV_TIMEOUT: navigation timeout (default: 30000 = 30 seconds)
NAV_TIMEOUT=30000

# QODERCLI_TIMEOUT: max time for qodercli login (default: 180000 = 3 minutes)
QODERCLI_TIMEOUT=180000

# Anti-banned: Randomization
# RANDOM_DELAY_MIN: minimum random delay (default: 1000)
RANDOM_DELAY_MIN=1000

# RANDOM_DELAY_MAX: maximum random delay (default: 3000)
RANDOM_DELAY_MAX=3000

# TYPING_DELAY_MIN: minimum typing delay per character (default: 30)
TYPING_DELAY_MIN=30

# TYPING_DELAY_MAX: maximum typing delay per character (default: 80)
TYPING_DELAY_MAX=80

# Retry Settings
# MAX_RETRIES: max retry rounds for failed accounts (0 = no retry, default: 0)
MAX_RETRIES=3

# RETRY_DELAY: delay before retry in milliseconds (default: 15000 = 15 seconds)
RETRY_DELAY=15000

# AUTO_RETRY: true = auto retry without asking, false = ask user (default: false)
AUTO_RETRY=false
