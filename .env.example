# Qoder Sign - Environment Configuration
# Copy this file to .env and adjust values as needed

# Browser Settings
HEADLESS=false
SLOW_MO=50

# Timeouts (in milliseconds)
DELAY_BETWEEN=8000
HP_PROMPT_WAIT=120000
NAV_TIMEOUT=30000
GOOGLE_TIMEOUT=120000

# Anti-banned Settings
RANDOM_DELAY_MIN=1000
RANDOM_DELAY_MAX=3000
TYPING_DELAY_MIN=30
TYPING_DELAY_MAX=80
